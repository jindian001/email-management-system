# ===== 基础 =====
MAILMIND_ENV=dev
MAILMIND_APP_NAME=MailMind

# ===== 存储 =====
# 开发用 SQLite；生产用 postgresql+psycopg://user:pass@localhost:5432/mailmind
MAILMIND_DATABASE_URL=sqlite+pysqlite:///./var/mailmind.db
MAILMIND_STORAGE_BACKEND=local
MAILMIND_STORAGE_ROOT=./var/raw

# ===== 队列 =====
MAILMIND_REDIS_URL=redis://localhost:6379/0

# ===== 安全 =====
# 留空表示开发模式不校验；生产必须设置，客户端通过 X-API-Key 头携带
MAILMIND_API_KEY=

# ===== 垃圾邮件阈值 =====
MAILMIND_SPAM_PASS_THRESHOLD=0.70
MAILMIND_SPAM_QUARANTINE_THRESHOLD=0.95
MAILMIND_SPAM_REVIEW_LOW=0.20
MAILMIND_SPAM_REVIEW_HIGH=0.80

# ===== 自动回复 =====
MAILMIND_AUTO_REPLY_ENABLED=true
# review = AI 起草 + 人工审核；auto = 高置信度自动发送
MAILMIND_AUTO_REPLY_SEND_MODE=review
MAILMIND_AUTO_REPLY_MIN_CONFIDENCE=0.85
MAILMIND_AUTO_REPLY_COOLDOWN_HOURS=24
MAILMIND_AUTO_REPLY_MAX_THREAD_DEPTH=3

# ===== LLM =====
# template = 本地确定性生成（无需网络，默认）；openai = 兼容 OpenAI 协议的任意服务
MAILMIND_LLM_PROVIDER=template
MAILMIND_LLM_BASE_URL=https://api.deepseek.com/v1
MAILMIND_LLM_API_KEY=
MAILMIND_LLM_MODEL=deepseek-chat

# ===== IMAP 账号示例（仅演示）=====
# MAILMIND_IMAP_HOST=imap.example.com
# MAILMIND_IMAP_PORT=993
